---
import { getTeamImageFolder, getTeamImagePath } from "../utils/teamImages";
import { langSegment, localizedEntityName, localizedSlug, localizeUrlPath, allTeamsCardTitle, tournamentSubtitle, type Lang } from "../i18n/ui";

interface Props {
    type: string;
    name: string;
    path?: string;
    imageName?: string | null;
    tournament: string;
    hrefBase?: string;
    lang?: Lang;
}

const basePath = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;

const { type, name, path, imageName, tournament, hrefBase, lang = "es" } = Astro.props;
const linkBase = hrefBase ?? tournament;
const teamCountry = getTeamImageFolder(imageName);
const langSeg = langSegment(lang);
const slug = localizedSlug(type, path ?? "", tournament, lang);
const displayName = localizedEntityName(type, path ?? "", name, tournament, lang);
const mid = type === "team"
    ? (hrefBase ? `${localizeUrlPath(hrefBase, lang)}/` : teamCountry ? `${teamCountry}/` : "")
    : `${localizeUrlPath(linkBase, lang)}/`;
const href = `${basePath}${langSeg}${mid}${slug}`;
const cardBackground = `${tournament}-bg.jpg`;
const cardBackgroundImage = `url(${basePath}img/icons/${cardBackground})`;
const imageClass = "w-24";
const textClass = "text-center text-sm mt-3";
const imagePath = imageName
    ? type === "team"
        ? getTeamImagePath(imageName)
        : type === "country"
            ? `icons/${imageName}`
            : `${tournament}/${imageName}`
    : "";
---

{
    imageName ? (
        <div>
            {path ? (
                <div
                    class="link-card w-36 h-44 flex items-center justify-center bg-center bg-cover"
                    style={{
                        backgroundImage: cardBackgroundImage,
                    }}
                >
                    <a
                        href={href}
                        class="w-full h-full"
                    >
                        <div class="flex w-full h-full flex-col items-center justify-center">
                            <img
                                class={imageClass}
                                src={`${basePath}img/${imagePath}`}
                                alt={displayName}
                            />
                            <div class={textClass}>{displayName}</div>
                        </div>
                    </a>
                </div>
            ) : (
                <div
                    class="link-card w-full h-48 flex items-center justify-center bg-center bg-cover rounded-md"
                    style={{
                        backgroundImage: cardBackgroundImage,
                    }}
                >
                    <div class="flex w-full h-full flex-col items-center justify-center">
                        <img
                            class={imageClass}
                            src={`${basePath}img/${imagePath}`}
                            alt={displayName}
                        />
                        <div class={`text-center text-md my-3 mx-12`}>{displayName}</div>
                    </div>
                </div>
            )}
        </div>
    ) : (
    <div>
            {path ? (
        <div
            class="link-card w-full 
            md:w-36 h-32 md:h-44 flex 
            items-center justify-center bg-center bg-cover"
            style={{
                backgroundImage: cardBackgroundImage,
            }}
        >
            <a href={href} class="w-full h-full">
                <div class="flex px-8 sm:px-16 md:px-0 w-full h-full flex-col items-center justify-center">
                    <div class="text-center text-xl">
                        {allTeamsCardTitle(displayName, lang)}
                    </div>
                    {(tournament === "libertadores" || tournament === "sudamericana") && (
                        <div class="text-center text-md text-yellow-400">
                            {tournamentSubtitle(tournament, lang)}
                        </div>
                    )}
                </div>
            </a>
        </div>
        ) : (
                <div
                    class="link-card w-full h-44 flex items-center justify-center bg-center bg-cover rounded-md"
                    style={{
                        backgroundImage: cardBackgroundImage,
                    }}
                >
                    <div class="flex px-16 w-full h-full flex-col items-center justify-center">
                        <div class="text-center text-xl">
                            {displayName}
                        </div>
                        {(tournament === "libertadores" || tournament === "sudamericana") && (
                            <div class="text-center text-md text-yellow-400 mx-6">
                                {tournamentSubtitle(tournament, lang)}
                            </div>
                        )}
                    </div>
                </div>
            )}
        </div>
    )
}

<style>
    .link-card {
        list-style: none;
        display: flex;
        padding: 1px;
        border-radius: 7px;
        transition: background-position 0.6s cubic-bezier(0.22, 1, 0.36, 1);
        box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.1);
    }
    .link-card:is(:hover, :focus-within) {
        background-position: 0;
        background-image: var(--accent-gradient);
    }
    .link-card:is(:hover, :focus-within) h2 {
        color: rgb(var(--accent-light));
    }
</style>
