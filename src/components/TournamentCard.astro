---
import { langSegment, localizeUrlPath, type Lang } from "../i18n/ui";

interface Props {
	title: string;
	href: string;
    imagePath: string;
    imgSrc: string;
    backgroundImage: string;
    lang?: Lang;
}

const { href, title, imagePath, imgSrc, backgroundImage, lang = "es" } = Astro.props;
const isWorldCup = imgSrc.includes("mundial/");
const cardBackgroundImage = `url(${imagePath}${backgroundImage})`;
const linkHref = `${imagePath}${langSegment(lang)}${localizeUrlPath(href, lang)}`;
---

<li class={`link-card w-80 h-80 flex items-center justify-center bg-center bg-cover`}
    style={{
        backgroundImage: cardBackgroundImage,
        "--worldcup-card-background": cardBackgroundImage,
        }}
 >
	<a href={linkHref}
    >
        <img class={isWorldCup ? "worldcup-logo max-h-60 w-60 object-contain" : "max-h-56 w-56 object-contain"}
        src={`${imagePath}${imgSrc}`}
        alt={title} />
	</a>
</li>
<style>
	.link-card {
		list-style: none;
		display: flex;
		padding: 1px;
		border-radius: 7px;
		transition: background-position 0.6s cubic-bezier(0.22, 1, 0.36, 1);
		box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.1);
	}
	.link-card:is(:hover, :focus-within) {
		background-position: 0;
		background-image: var(--accent-gradient);
	}
    .worldcup-card {
        position: relative;
        overflow: hidden;
        background-position: 50% 50%;
        background-size: 122% 122%;
        box-shadow:
            inset 0 0 0 1px rgba(255, 255, 255, 0.16),
            0 18px 42px rgba(18, 80, 170, 0.18);
    }
    .worldcup-card:is(:hover, :focus-within) {
        background-image: var(--worldcup-card-background);
        background-position: 65% 48%;
    }
    .worldcup-logo {
        filter:
            drop-shadow(0 0 10px rgba(255, 255, 255, 0.22))
            drop-shadow(0 16px 28px rgba(0, 0, 0, 0.72));
        transform: translateY(4px);
    }
	.link-card:is(:hover, :focus-within) h2 {
		color: rgb(var(--accent-light));
	}
</style>
