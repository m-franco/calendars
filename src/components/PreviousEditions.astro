---
interface Edition {
    year: string;
    title: string;
    href: string;
    imgSrc: string;
    backgroundImage: string;
}

interface Props {
    editions: Edition[];
}

const basePath = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
const { editions } = Astro.props;
---

{editions.length > 0 && (
    <section class="mt-12">
        <h2 class="text-2xl sm:text-3xl font-bold text-center mb-4">
            Ediciones anteriores
        </h2>
        <ul role="list" class="flex flex-wrap justify-center gap-4">
            {editions.map(({ year, title, href, imgSrc, backgroundImage }) => (
                <li
                    class="edition-card w-72 h-72 sm:w-80 sm:h-80 bg-center bg-cover"
                    style={{ backgroundImage: `url(${basePath}${backgroundImage})` }}
                >
                    <a
                        href={`${basePath}${href}`}
                        class="relative flex h-full w-full flex-col items-center justify-center overflow-hidden rounded-[7px]"
                        aria-label={`${title} ${year}`}
                    >
                        <div class="absolute inset-0 bg-slate-950/25"></div>
                        <img
                            class="relative z-10 w-44 sm:w-52"
                            src={`${basePath}${imgSrc}`}
                            alt={title}
                        />
                        <div class="relative z-10 mt-5 rounded-full border border-cyan-200/30 bg-cyan-950/80 px-5 py-2 text-center shadow-lg">
                            <span class="block text-xs uppercase tracking-[0.25em] text-cyan-100/80">
                                Edición
                            </span>
                            <span class="block text-3xl font-bold leading-none text-white">
                                {year}
                            </span>
                        </div>
                    </a>
                </li>
            ))}
        </ul>
    </section>
)}

<style>
    .edition-card {
        list-style: none;
        display: flex;
        padding: 1px;
        border-radius: 7px;
        transition: background-position 0.6s cubic-bezier(0.22, 1, 0.36, 1);
        box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.1);
    }
    .edition-card:is(:hover, :focus-within) {
        background-position: 0;
        background-image: var(--accent-gradient);
    }
</style>
