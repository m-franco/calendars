---
import TeamCard from "./TeamCard.astro";
import { localizeGroupName, type Lang } from "../i18n/ui";

interface Group {
    name: string;
    path: string;
    teams: any[];
}
interface Props {
    groups: Group[];
    tournament: string;
    hrefBase?: string;
    teamHrefBase?: string;
    showGroupCalendar?: boolean;
    compactGrid?: boolean;
    lang?: Lang;
}

const {
    groups,
    tournament,
    hrefBase,
    teamHrefBase,
    showGroupCalendar = true,
    compactGrid = false,
    lang = "es",
} = Astro.props;
const teamListClass = compactGrid
    ? "grid grid-cols-2 md:grid-cols-4 justify-items-center gap-2"
    : "flex flex-wrap justify-around gap-2";
---

<ul role="list" class="flex flex-col">
    {
        groups.map(({ name, path, teams }) => (
            <li class="bg-cyan-700/50 my-2 pb-3 pt-2 px-2 rounded-xl">
                <div class="w-full text-center mb-2">{localizeGroupName(name, lang)}</div>
                <ul role="list" class={teamListClass}>
                    {showGroupCalendar && (
                        <TeamCard type="group" name={name} path={path} tournament={tournament} hrefBase={hrefBase} lang={lang} />
                    )}
                    {teams.map(({ name, path, imageName, linkBase }) => (
                        <li>
                            <TeamCard
                                type="team"
                                name={name}
                                path={path}
                                imageName={imageName}
                                tournament={tournament}
                                hrefBase={linkBase ?? teamHrefBase ?? hrefBase}
                                lang={lang}
                            />
                        </li>
                    ))}
                </ul>
            </li>
        ))
    }
</ul>
