---
import CountryCard from "./CountryCard.astro";
import { sectionName, type Lang } from "../i18n/ui";

interface Group {
    name: string;
    teams: any[];
}
interface Props {
    countries: Group[];
    tournament: string;
    hrefBase?: string;
    lang?: Lang;
}

const { countries, tournament, hrefBase, lang = "es" } = Astro.props;
const entityType = hrefBase === "selecciones" ? "confederation" : "country";
---

<ul role="list" class="flex flex-col">
    {
        countries.map(({ name, teams }) => (
            <li class="bg-cyan-700/50 my-2 pb-3 pt-2 px-2 rounded-xl">
                <div class="w-full text-center mb-2">{sectionName(name, lang)}</div>
                <ul role="list" class="flex flex-wrap justify-around gap-2">
                    {teams.map(({ name, path, imageName }) => (
                        <li>
                            <CountryCard
                                name={name}
                                path={path}
                                imageName={imageName}
                                tournament={tournament}
                                hrefBase={hrefBase}
                                type={entityType}
                                lang={lang}
                            />
                        </li>
                    ))}
                </ul>
            </li>
        ))
    }
</ul>
