---
interface Props {
    name: string;
    imageName?: string | null;
    tournament: string;
    year?: string;
    title?: string;
}

const basePath = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
const { name, imageName, tournament, year, title } = Astro.props;
---

<div class="tournament-calendar-subject">
    {imageName && (
        <img
            class="tournament-calendar-subject-image"
            src={`${basePath}img/icons/${tournament}/${imageName}`}
            alt={name}
        />
    )}
    <div class="text-center text-md mt-3">
        {title ?? `Calendario de todos los equipos de la ${name}${year ? ` ${year}` : ""}`}
    </div>
</div>

<style>
    .tournament-calendar-subject {
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .tournament-calendar-subject-image {
        display: block;
        width: 7rem;
        height: 7rem;
        object-fit: contain;
        position: relative;
        z-index: 1;
    }

    .tournament-calendar-subject {
        position: relative;
    }

    .tournament-calendar-subject::before {
        content: "";
        position: absolute;
        top: -0.75rem;
        width: 9rem;
        height: 9rem;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.7);
        filter: blur(1.25rem);
        opacity: 0.65;
        pointer-events: none;
    }
</style>
