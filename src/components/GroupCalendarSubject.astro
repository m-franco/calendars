---
import { getTeamImagePath } from "../utils/teamImages";

interface Team {
    name: string;
    imageName: string;
}

interface Props {
    name: string;
    tournamentName?: string;
    year?: string;
    teams: Team[];
    title?: string;
}

const basePath = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
const { name, tournamentName, year, teams, title } = Astro.props;
---

<div class="group-subject">
    <div class="text-center text-md">
        {title ?? `Calendario de todos los equipos del ${name} de la ${tournamentName}${year ? ` ${year}` : ""}`}
    </div>
    <ul role="list" class="group-teams">
        {teams.map(({ name: teamName, imageName }) => (
            <li class="group-team">
                <img
                    class="group-team-image"
                    src={`${basePath}img/${getTeamImagePath(imageName)}`}
                    alt={teamName}
                />
            </li>
        ))}
    </ul>
</div>

<style>
    .group-subject {
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1.25rem;
    }

    .group-teams {
        width: min(100%, 24rem);
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 0.75rem;
    }

    .group-team {
        min-width: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .group-team-image {
        width: 3.25rem;
        height: 3.25rem;
        object-fit: contain;
    }

    @media (min-width: 640px) {
        .group-team-image {
            width: 4rem;
            height: 4rem;
        }
    }
</style>
