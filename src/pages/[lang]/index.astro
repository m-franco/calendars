---
import Home from "../../components/pages/Home.astro";
import { alternatesFor, urlFor, type Lang } from "../../i18n/ui";

export function getStaticPaths() {
    return (["es", "en", "pt"] as Lang[]).map((lang) => ({ params: { lang }, props: { lang } }));
}

const { lang } = Astro.props as { lang: Lang };
const alternates = alternatesFor((l) => urlFor(l));
---

<Home lang={lang} alternates={alternates} />
