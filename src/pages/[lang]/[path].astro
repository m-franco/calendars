---
import CalendarDetail from "../../components/pages/CalendarDetail.astro";
import { detailPaths } from "../../i18n/paths";
import { alternatesFor, urlFor, localizedSlug, type Lang } from "../../i18n/ui";

export function getStaticPaths() {
    return (["es", "en", "pt"] as Lang[]).flatMap((l) =>
        detailPaths(l).map((e) => ({ params: { lang: l, ...e.params }, props: e.props }))
    );
}

const { lang, type, esName, esPath, tournament, imageName } = Astro.props as any;
const alternates = alternatesFor((l) => urlFor(l, [localizedSlug(type, esPath, tournament, l)]));
---

<CalendarDetail
    lang={lang}
    type={type}
    esPath={esPath}
    esName={esName}
    tournament={tournament}
    imageName={imageName}
    alternates={alternates}
/>
