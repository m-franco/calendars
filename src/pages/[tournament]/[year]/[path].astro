---
import CalendarDetail from "../../../components/pages/CalendarDetail.astro";
import { yearDetailPaths } from "../../../i18n/paths";
import { alternatesFor, urlFor, localizedSlug, localizedTournamentSlug } from "../../../i18n/ui";

export function getStaticPaths() {
    return yearDetailPaths("es");
}

const { year } = Astro.params;
const { type, esName, esPath, tournament, imageName } = Astro.props as any;
const alternates = alternatesFor((l) =>
    urlFor(l, [localizedTournamentSlug(tournament, l), year!, localizedSlug(type, esPath, tournament, l)])
);
---

<CalendarDetail
    lang="es"
    type={type}
    esPath={esPath}
    esName={esName}
    tournament={tournament}
    imageName={imageName}
    year={year}
    archived={year !== "2026"}
    alternates={alternates}
/>
