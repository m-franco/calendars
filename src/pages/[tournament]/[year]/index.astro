---
import TournamentIndex from "../../../components/pages/TournamentIndex.astro";
import { yearIndexPaths } from "../../../i18n/paths";
import { alternatesFor, urlFor, localizedTournamentSlug } from "../../../i18n/ui";

export function getStaticPaths() {
    return yearIndexPaths("es");
}

const { href, year } = Astro.props as any;
const alternates = alternatesFor((l) => urlFor(l, [localizedTournamentSlug(href, l), year]));
---

<TournamentIndex lang="es" tournament={href} year={year} alternates={alternates} />
