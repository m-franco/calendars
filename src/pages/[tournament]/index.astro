---
import Layout from '../../layouts/Layout.astro';
import Teams from '../../components/Teams.astro';
import Countries from '../../components/Countries.astro';
import AllTournament from '../../components/AllTournament.astro';
import PreviousEditions from '../../components/PreviousEditions.astro';
import { countries, tournaments, tournamentPages  } from "../../data.json";
import { tournaments as worldcupTournaments, tournamentPages as worldcupTournamentPages } from "../../worldcup-data.json";

export async function getStaticPaths() {
    const allTournamentPages = [...worldcupTournamentPages, ...tournamentPages];

    return allTournamentPages.map(({ typeName, name, tournament }) => {
        return {
            params: { tournament },
            props: { typeName, name },
        };
    });
}

const { tournament } = Astro.params;
const { typeName, name } = Astro.props;
const currentEditionYear = "2026";
const allTournaments = [...worldcupTournaments, ...tournaments];

const tournamentData = allTournaments.find((t) => t.href === tournament)! as any;

const { href, imgSrc, backgroundImage } = tournamentData;
const groups = tournamentData["groups"];
const countriesForTournament = tournamentData["countries"] ?? countries;
const allTournamentTitle = href === "mundial"
    ? `Calendario de todas las selecciones de la ${typeName} ${name}`
    : `Calendario de todos los equipos de la ${typeName} ${name}`;
const qualifiedFromLibertadores = tournamentData["qualifiedFromLibertadores"] ?? [];
const previousEditions = href === "mundial" ? [] : [
    {
        year: "2025",
        title: tournamentData.title,
        href: `${href}/2025`,
        imgSrc,
        backgroundImage,
    },
    {
        year: "2024",
        title: tournamentData.title,
        href: `${href}/2024`,
        imgSrc,
        backgroundImage,
    },
];


const description="Suscribite al calendario de tu equipo, de todo el grupo o de toda la copa y tendrás todos los partidos incluidos en el calendario de tu teléfono o tu computadora.";

const image=`../../${imgSrc}`;

---

<Layout 
    title=`Calendarios de ${name}`
    description={description}
    image={image}
    >
	
	<main>
        <h1 class="
            text-4xl sm:text-5xl md:text-6xl lg:text-7xl  
            text-center font-bold  p-0.5 mb-4">
            {typeName} <span class="text-gradient">{name}</span>
        </h1>

		<p class="instructions flex justify-center 
        text-sm sm:text-base md:text-lg lg:text-xl mt-12
        ">
            {description}
        </p>
        <AllTournament 
            title={allTournamentTitle}
            href=`${href}/Completa`
            imgSrc={imgSrc}
            backgroundImage={backgroundImage}
        />
        <Countries countries={countriesForTournament} tournament={href} hrefBase={href === "mundial" ? "selecciones" : undefined} />
        {href === "sudamericana" && qualifiedFromLibertadores.length > 0 && (
            <section class="my-6">
                <Teams
                    groups={qualifiedFromLibertadores}
                    tournament={href}
                    showGroupCalendar={false}
                    compactGrid={true}
                />
            </section>
        )}
        <Teams groups={groups} tournament={href} hrefBase={`${href}/${currentEditionYear}`} teamHrefBase={href === "mundial" ? "seleccion" : undefined} />
        {previousEditions.length > 0 && <PreviousEditions editions={previousEditions} />}
	</main>
</Layout>

<style>
	main {
		margin: auto;
		padding: 1rem;
		width: 800px;
		max-width: calc(100% - 2rem);
		color: white;
		font-size: 20px;
		line-height: 1.6;
	}
	.text-gradient {
		background-image: var(--accent-gradient);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-size: 400%;
		background-position: 0%;
	}
	.instructions {
		margin-bottom: 2rem;
		border: 1px solid rgba(var(--accent-light), 25%);
		background: linear-gradient(rgba(var(--accent-dark), 66%), rgba(var(--accent-dark), 33%));
		padding: 1.5rem;
		border-radius: 8px;
	}
</style>
