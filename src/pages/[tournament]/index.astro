---
import TournamentIndex from "../../components/pages/TournamentIndex.astro";
import { tournamentIndexPaths } from "../../i18n/paths";
import { alternatesFor, urlFor, localizedTournamentSlug } from "../../i18n/ui";

export function getStaticPaths() {
    return tournamentIndexPaths("es");
}

const { href } = Astro.props as any;
const alternates = alternatesFor((l) => urlFor(l, [localizedTournamentSlug(href, l)]));
---

<TournamentIndex lang="es" tournament={href} alternates={alternates} />
