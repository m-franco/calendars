---
import CalendarDetail from "../../components/pages/CalendarDetail.astro";
import { tournamentDetailPaths } from "../../i18n/paths";
import { alternatesFor, urlFor, localizedSlug, localizedTournamentSlug } from "../../i18n/ui";

export function getStaticPaths() {
    return tournamentDetailPaths("es");
}

const { type, esName, esPath, imageName, sourceTournament, urlTournamentBase } = Astro.props as any;
const alternates = alternatesFor((l) =>
    urlFor(l, [localizedTournamentSlug(urlTournamentBase, l), localizedSlug(type, esPath, sourceTournament, l)])
);
---

<CalendarDetail
    lang="es"
    type={type}
    esPath={esPath}
    esName={esName}
    tournament={sourceTournament}
    imageName={imageName}
    alternates={alternates}
/>
