---
import Layout from "../../layouts/Layout.astro";
import GroupCalendarSubject from "../../components/GroupCalendarSubject.astro";
import TournamentCalendarSubject from "../../components/TournamentCalendarSubject.astro";
import CalendarCard from "../../components/CalendarCard.astro";
import { calendarPages, calendars, tournaments } from "../../data.json";
import { calendarPages as calendarPages2024 } from "../../data-2024.json";
import { calendarPages as calendarPages2025 } from "../../data-2025.json";
import { calendarPages as worldcupCalendarPages, tournaments as worldcupTournaments } from "../../worldcup-data.json";
import { withCalendarSubscriptionName } from "../../utils/calendarLinks";
import { getCalendarFilePath, getTeamImagePath } from "../../utils/teamImages";

export async function getStaticPaths() {
    const allCalendarPages = [
        ...worldcupCalendarPages.filter(({ type }) => type !== "group"),
        ...calendarPages2024,
        ...calendarPages2025,
        ...calendarPages,
    ];
    const uniqueCalendarPages = Array.from(
        new Map(
            allCalendarPages.map((page) => [`${page.tournament}/${page.path}`, page])
        ).values()
    );

    return uniqueCalendarPages.map(({ type, name, path, tournament, imageName }) => ({
            params: {
                path,
                tournament: tournament === "mundial"
                    ? type === "team"
                        ? "seleccion"
                        : type === "confederation"
                            ? "selecciones"
                            : tournament
                    : tournament,
            },
            props: { type, name, imageName, sourceTournament: tournament },
    }));
}


const calendarBasePath = "m-franco.github.io/calendars/";
const basePath = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;

const { path, tournament } = Astro.params;
const { type, name, imageName, sourceTournament } = Astro.props;
const pageTournament = sourceTournament ?? tournament;

const currentEditionYear = "2026";
const allTournaments = [...worldcupTournaments, ...tournaments];
const tournamentData = allTournaments.find(({ href }) => href === pageTournament)! as any;
const tournamentName = tournamentData.title;
const tournamentCalendarFile = tournamentData.calendarFile ?? (pageTournament === "libertadores" ? "Libertadores.ics" : "Sudamericana.ics");
const isWorldCup = pageTournament === "mundial";
const calendarSubject = {
    tournament: isWorldCup ? `todas las selecciones de la ${tournamentName}` : `la ${tournamentName}`,
    country: `todos los ${name.toLocaleLowerCase()}`,
    confederation: name.toLocaleLowerCase(),
    group: isWorldCup
        ? `todas las selecciones del ${name} de la ${tournamentName} ${currentEditionYear}`
        : `todos los equipos del ${name} de la ${tournamentName} ${currentEditionYear}`,
    team: name,
}[type] ?? `${name} en la ${tournamentName}`;

const description = `Suscribite al calendario de ${calendarSubject}. Tendrás todos los partidos incluidos en el calendario de tu teléfono o tu computadora.`;

const title = `Calendario de ${calendarSubject}`;

const imagePath = imageName
    ? type === "team"
        ? getTeamImagePath(imageName)
        : type === "country"
            ? `icons/${imageName}`
            : type === "confederation"
                ? `icons/${imageName}`
                : `icons/${pageTournament}/${imageName}`
    : "";
const image = imageName
    ? `../../img/${imagePath}`
    : `../../img/icons/${pageTournament + (pageTournament === "libertadores" ? "-logo" : "")}.png`;
const calendarFilePath = getCalendarFilePath(type, path!, pageTournament!, imageName);
const groupTeams = type === "group"
    ? allTournaments
        .find(({ href }) => href === pageTournament)
        ?.groups.find(({ path: groupPath }) => groupPath === path)
        ?.teams ?? []
    : [];

---

<Layout 
    title={title}
    description={description}
    image={image}
>
    <main>
        <h1 class="
            text-4xl sm:text-5xl md:text-6xl lg:text-7xl  
            text-center font-bold  p-0.5 mb-4">
            <span class="text-gradient">{name}</span>
        </h1>
        {type !== "tournament" && type !== "country" && type !== "team" &&
        <h2 class="text-lg sm:text-xl md:text-2xl lg:text-3xl">
            {tournamentName} {currentEditionYear}
        </h2>}
        <div class="instructions flex flex-col justify-center 
        text-sm sm:text-base md:text-lg lg:text-xl my-12">
            <p>Suscribite al calendario de {calendarSubject}.</p>
            <span>
            Tendrás todos los partidos incluidos
            en el calendario de tu teléfono o tu computadora.</span>
        </div>

        <div class="w-full flex items-center justify-center my-4">
            {type === "tournament" && (
                <TournamentCalendarSubject
                    name={name}
                    imageName={imageName}
                    tournament={pageTournament}
                    title={isWorldCup ? `Calendario de todas las selecciones de la ${name}` : undefined}
                />
            )}
            {type === "group" && (
                <GroupCalendarSubject
                    name={name}
                    tournamentName={tournamentName}
                    year={currentEditionYear}
                    teams={groupTeams}
                    title={isWorldCup ? `Calendario de todas las selecciones del ${name} de la ${tournamentName} ${currentEditionYear}` : undefined}
                />
            )}
            {(type === "team" || type === "country" || type === "confederation") && imageName && (
                <div class="calendar-subject">
                    <img
                        class="calendar-subject-image"
                        src={`${basePath}img/${imagePath}`}
                        alt={name}
                    />
                    <div class="text-center text-md mt-3">
                        {type === "country" ? `Calendario de todos los ${name.toLocaleLowerCase()}` : name}
                    </div>
                </div>
            )}
        </div>
        <div role="list" class="flex flex-col">
            <div class="bg-cyan-700/50 rounded-xl w-full px-1 py-4">
                <ul role="list" class="flex flex-wrap justify-around gap-2">
                    {
                        calendars.map(({ calendar, imageName, preLink, target }) => (
                            <li class="">
                                <CalendarCard
                                    calendar={calendar}
                                    link={withCalendarSubscriptionName(type==="tournament"
                                    ?`${preLink}${calendarBasePath}${tournamentCalendarFile}`
                                    :`${preLink}${calendarBasePath}${calendarFilePath}`, title)}
                                    imageName={imageName}
                                    tournament={pageTournament}
                                    target={target}
                                />
                            </li>
                        ))
                    }
                </ul>
            </div>
        </div>
    </main>
</Layout>

<style>
    main {
        margin: auto;
        padding: 1rem;
        width: 800px;
        max-width: calc(100% - 2rem);
        color: white;
        font-size: 20px;
        line-height: 1.6;
    }

    h2 {
        font-weight: 600;
        text-align: center;
        margin-bottom: 2em;
    }
    .text-gradient {
        background-image: var(--accent-gradient);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-size: 400%;
        background-position: 0%;
    }
    .instructions {
        margin-bottom: 2rem;
        border: 1px solid rgba(var(--accent-light), 25%);
        background: linear-gradient(
            rgba(var(--accent-dark), 66%),
            rgba(var(--accent-dark), 33%)
        );
        padding: 1.5rem;
        border-radius: 8px;
    }

    .calendar-subject-image {
        display: block;
        width: 7rem;
        height: 7rem;
        object-fit: contain;
        position: relative;
        z-index: 1;
    }

    .calendar-subject {
        display: flex;
        flex-direction: column;
        align-items: center;
        position: relative;
    }

    .calendar-subject::before {
        content: "";
        position: absolute;
        top: -0.75rem;
        width: 9rem;
        height: 9rem;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.7);
        filter: blur(1.25rem);
        opacity: 0.65;
        pointer-events: none;
    }
</style>
