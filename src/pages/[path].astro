---
import CalendarDetail from "../components/pages/CalendarDetail.astro";
import { detailPaths } from "../i18n/paths";
import { alternatesFor, urlFor, localizedSlug } from "../i18n/ui";

export function getStaticPaths() {
    return detailPaths("es");
}

const { type, esName, esPath, tournament, imageName } = Astro.props as any;
const alternates = alternatesFor((l) => urlFor(l, [localizedSlug(type, esPath, tournament, l)]));
---

<CalendarDetail
    lang="es"
    type={type}
    esPath={esPath}
    esName={esName}
    tournament={tournament}
    imageName={imageName}
    alternates={alternates}
/>
