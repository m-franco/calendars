---
// La raíz redirige al idioma por defecto (/es/). Cada idioma vive bajo su
// segmento: /es, /en, /pt.
import { urlFor } from "../i18n/ui";

const target = urlFor("es");
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta http-equiv="refresh" content={`0; url=${target}`} />
        <link rel="canonical" href={target} />
        <title>Calendarios Deportivos</title>
        <script is:inline define:vars={{ target }}>
            window.location.replace(target);
        </script>
    </head>
    <body>
        <a href={target}>Calendarios Deportivos</a>
    </body>
</html>
