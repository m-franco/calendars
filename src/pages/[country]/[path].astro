---
import CalendarDetail from "../../components/pages/CalendarDetail.astro";
import { countryTeamPaths } from "../../i18n/paths";
import { alternatesFor, urlFor } from "../../i18n/ui";

export function getStaticPaths() {
    return countryTeamPaths("es");
}

const { country } = Astro.params;
const { type, esName, esPath, tournament, imageName } = Astro.props as any;
// Los clubes no cambian de slug entre idiomas.
const alternates = alternatesFor((l) => urlFor(l, [country!, esPath]));
---

<CalendarDetail
    lang="es"
    type={type}
    esPath={esPath}
    esName={esName}
    tournament={tournament}
    imageName={imageName}
    alternates={alternates}
/>
