---
import {
    LANGS,
    LANG_NAMES,
    LANG_FLAGS,
    urlFor,
    supportUrl,
    supportCopy,
    t,
    tournamentTitle,
    localizedTournamentSlug,
    extraPages,
    extraPageUrl,
    type Lang,
} from "../i18n/ui";

interface Props {
    title: string;
    description: string;
    image: string;
    lang?: Lang;
    alternates?: Record<Lang, string>;
    imageWidth?: number;
    imageHeight?: number;
}

const {
    title,
    description,
    image,
    lang = "es",
    alternates,
    imageWidth,
    imageHeight,
} = Astro.props;
const basePath = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
const langLinks: Record<Lang, string> =
    alternates ??
    ({
        es: urlFor("es"),
        en: urlFor("en"),
        pt: urlFor("pt"),
    } as Record<Lang, string>);

// Origen del sitio para construir URLs absolutas (las redes sociales no
// resuelven rutas relativas al compartir).
const site = Astro.site ?? new URL("https://m-franco.github.io");
const canonicalURL = new URL(Astro.url.pathname, site);

// Normaliza la imagen a una ruta absoluta. WhatsApp/Twitter no renderizan SVG,
// así que para esos casos usamos una imagen de respaldo.
let imagePath = image;
if (!/^https?:\/\//.test(imagePath)) {
    if (!imagePath.startsWith("/")) imagePath = basePath + imagePath;
    if (imagePath.endsWith(".svg")) imagePath = `${basePath}img/cup1.jpg`;
}
const socialImage = /^https?:\/\//.test(imagePath)
    ? imagePath
    : new URL(imagePath, site).href;

const ogLocale: Record<Lang, string> = {
    es: "es_ES",
    en: "en_US",
    pt: "pt_BR",
};
const localeAlternates = (Object.keys(ogLocale) as Lang[]).filter(
    (l) => l !== lang,
);

// Footer
const footerTournaments = ["libertadores", "sudamericana", "mundial"];
const footerTagline: Record<Lang, string> = {
    es: "Sincroniza tu calendario con tus copas favoritas.",
    en: "Sync your calendar with your favorite cups.",
    pt: "Sincronize seu calendário com suas copas favoritas.",
};
---

<!doctype html>
<html lang={lang}>
    <head>
        <meta charset="UTF-8" />
        <meta name="description" content={description} />
        <meta name="viewport" content="width=device-width" />
        <link
            rel="icon"
            type="image/svg+xml"
            href={`${basePath}calendar.svg`}
        />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
        <link rel="canonical" href={canonicalURL.href} />
        {
            Object.entries(langLinks).map(([l, href]) => (
                <link
                    rel="alternate"
                    hreflang={l}
                    href={new URL(href, site).href}
                />
            ))
        }

        <!-- Open Graph (WhatsApp, Facebook, etc.) -->
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="myFixtu.re" />
        <meta property="og:locale" content={ogLocale[lang]} />
        {
            localeAlternates.map((l) => (
                <meta property="og:locale:alternate" content={ogLocale[l]} />
            ))
        }
        <meta property="og:url" content={canonicalURL.href} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={socialImage} />
        <meta property="og:image:secure_url" content={socialImage} />
        {
            imageWidth && (
                <meta property="og:image:width" content={String(imageWidth)} />
            )
        }
        {
            imageHeight && (
                <meta
                    property="og:image:height"
                    content={String(imageHeight)}
                />
            )
        }
        <meta property="og:image:alt" content={title} />

        <!-- Twitter -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={socialImage} />
        <meta name="twitter:image:alt" content={title} />
        <script
            is:inline
            async
            src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-5623233007287475"
            crossorigin="anonymous"></script>
    </head>
    <script
        is:inline
        type="text/partytown"
        async
        src="https://www.googletagmanager.com/gtag/js?id=G-GNCT8SRLL8"></script>
    <script is:inline type="text/partytown">
        window.dataLayer = window.dataLayer || [];
        function gtag() {
            dataLayer.push(arguments);
        }
        gtag("js", new Date());

        gtag("config", "G-GNCT8SRLL8");
    </script>
    <body>
        <div
            class="fixed inset-0 -z-10 h-full w-full items-center px-5 py-24
        [background:radial-gradient(125%_125%_at_50%_10%,#000_40%,#63e_100%)]"
        >
        </div>
        <header class="site-header">
            <a class="site-logo" href={urlFor(lang)}>myFixtu.re</a>
            <details class="lang-switcher" id="lang-switcher">
                <summary aria-label="Idioma / Language">
                    <span class="lang-flag">{LANG_FLAGS[lang]}</span>
                    <span class="lang-name">{LANG_NAMES[lang]}</span>
                    <svg
                        class="lang-chevron"
                        viewBox="0 0 12 8"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"><path d="M1 1.5l5 5 5-5"></path></svg
                    >
                </summary>
                <ul class="lang-menu">
                    {
                        LANGS.map((l) => (
                            <li>
                                <a
                                    href={langLinks[l]}
                                    hreflang={l}
                                    class={l === lang ? "current" : ""}
                                >
                                    <span class="lang-flag">
                                        {LANG_FLAGS[l]}
                                    </span>
                                    <span class="lang-name">
                                        {LANG_NAMES[l]}
                                    </span>
                                    {l === lang && (
                                        <span
                                            class="lang-check"
                                            aria-hidden="true"
                                        >
                                            ✓
                                        </span>
                                    )}
                                </a>
                            </li>
                        ))
                    }
                </ul>
            </details>
        </header>
        <script is:inline>
            (function () {
                const d = document.getElementById("lang-switcher");
                if (!d) return;
                // Cerrar al hacer click afuera.
                document.addEventListener("click", (e) => {
                    if (!d.contains(e.target)) d.removeAttribute("open");
                });
                // Cerrar al volver con "atrás" (restauración desde bfcache).
                window.addEventListener("pageshow", () =>
                    d.removeAttribute("open"),
                );
            })();
        </script>
        <slot />
        <footer class="site-footer">
            <div class="footer-inner">
                <a class="footer-brand" href={urlFor(lang)}
                    >{t(lang).homeTitle}</a
                >
                <p class="footer-tagline">{footerTagline[lang]}</p>
                <nav class="footer-nav">
                    {
                        footerTournaments.map((href, i) => (
                            <>
                                {i > 0 && <span aria-hidden="true">·</span>}
                                <a
                                    href={urlFor(lang, [
                                        localizedTournamentSlug(href, lang),
                                    ])}
                                >
                                    {tournamentTitle(href, lang)}
                                </a>
                            </>
                        ))
                    }
                </nav>
                <nav class="footer-nav footer-nav-secondary">
                    <a href={extraPageUrl("faq", lang)}>{extraPages.faq.nav[lang]}</a>
                    <span aria-hidden="true">·</span>
                    <a href={extraPageUrl("privacy", lang)}>{extraPages.privacy.nav[lang]}</a>
                    <span aria-hidden="true">·</span>
                    <a href={supportUrl(lang)}>♥ {supportCopy[lang].nav}</a>
                </nav>
                <div class="footer-copy">
                    © {new Date().getFullYear()}
                    <a href={urlFor(lang)}>myfixtu.re</a>
                </div>
            </div>
        </footer>
        <script is:inline>
            // Trackeo de clicks en los botones de suscripción (evento GA4).
            (function () {
                window.dataLayer = window.dataLayer || [];
                function track() { window.dataLayer.push(arguments); }
                document.addEventListener("click", function (e) {
                    var a = e.target.closest && e.target.closest("a[data-track-subscribe]");
                    if (!a) return;
                    track("event", "subscribe_click", {
                        calendar: a.getAttribute("data-cal") || "",
                        calendar_file: a.getAttribute("data-file") || "",
                        app: a.getAttribute("data-app") || "",
                        language: document.documentElement.lang || "",
                    });
                }, true);
            })();
        </script>
    </body>
</html>
<style is:global>
    :root {
        --accent: 136, 58, 234;
        --accent-light: 224, 204, 250;
        --accent-dark: 49, 10, 101;
        --accent-gradient: linear-gradient(
            45deg,
            rgb(var(--accent)),
            rgb(var(--accent-light)) 30%,
            white 60%
        );
    }
    html {
        font-family: system-ui, sans-serif;
        background: #13151a;
        background-size: 224px;
    }
    .site-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        max-width: 960px;
        margin: 0 auto;
        padding: 1rem 1.25rem;
    }
    .site-logo {
        font-weight: 800;
        font-size: 1.5rem;
        letter-spacing: -0.01em;
        text-decoration: none;
        background-image: var(--accent-gradient);
        background-size: 200%;
        -webkit-background-clip: text;
        background-clip: text;
        -webkit-text-fill-color: transparent;
        color: transparent;
        transition: background-position 0.4s ease;
    }
    .site-logo:hover {
        background-position: 100%;
    }
    .lang-switcher {
        position: relative;
        z-index: 50;
        flex-shrink: 0;
    }
    .lang-switcher > summary {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        cursor: pointer;
        list-style: none;
        color: white;
        background-color: rgba(8, 47, 73, 0.85);
        border: 1px solid rgba(var(--accent-light), 35%);
        border-radius: 9999px;
        padding: 0.4rem 1.1rem;
        font-size: 0.9rem;
        backdrop-filter: blur(6px);
        box-shadow: 0 4px 14px rgba(0, 0, 0, 0.35);
        user-select: none;
    }
    .lang-switcher > summary::-webkit-details-marker {
        display: none;
    }
    .lang-switcher > summary:focus-visible {
        outline: 2px solid rgb(var(--accent-light));
    }
    .lang-chevron {
        width: 0.7rem;
        height: 0.7rem;
        transition: transform 0.2s ease;
    }
    .lang-switcher[open] .lang-chevron {
        transform: rotate(180deg);
    }
    .lang-menu {
        position: absolute;
        right: 0;
        margin-top: 0.4rem;
        min-width: 100%;
        list-style: none;
        padding: 0.3rem;
        background-color: rgba(8, 47, 73, 0.96);
        border: 1px solid rgba(var(--accent-light), 35%);
        border-radius: 0.9rem;
        box-shadow: 0 10px 28px rgba(0, 0, 0, 0.45);
        backdrop-filter: blur(8px);
    }
    .lang-menu a {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.45rem 0.7rem;
        border-radius: 0.6rem;
        color: white;
        text-decoration: none;
        font-size: 0.9rem;
        white-space: nowrap;
    }
    .lang-menu a:hover,
    .lang-menu a:focus-visible {
        background-color: rgba(var(--accent-light), 18%);
    }
    .lang-menu a.current {
        font-weight: 600;
    }
    .lang-check {
        margin-left: auto;
        color: rgb(var(--accent-light));
    }
    .site-footer {
        margin-top: 4rem;
        background: rgba(4, 20, 38, 0.6);
        border-top: 1px solid rgba(var(--accent-light), 15%);
        backdrop-filter: blur(4px);
    }
    .footer-inner {
        max-width: 800px;
        margin: 0 auto;
        padding: 2.5rem 1rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.7rem;
        text-align: center;
    }
    .footer-brand {
        color: #fff;
        font-weight: 700;
        font-size: 1rem;
        text-decoration: none;
    }
    .footer-brand:hover {
        color: rgb(var(--accent-light));
    }
    .footer-tagline {
        color: rgba(255, 255, 255, 0.55);
        font-size: 0.9rem;
        margin: 0 0 0.3rem;
        max-width: 32rem;
    }
    .footer-nav {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        align-items: center;
        gap: 0.5rem 0.7rem;
        font-size: 0.9rem;
        color: rgba(255, 255, 255, 0.45);
    }
    .footer-nav-secondary {
        font-size: 0.85rem;
        opacity: 0.9;
    }
    .footer-nav a {
        color: rgba(var(--accent-light), 90%);
        text-decoration: none;
    }
    .footer-nav a:hover {
        text-decoration: underline;
    }
    .footer-copy {
        color: rgba(255, 255, 255, 0.4);
        font-size: 0.8rem;
    }
    .footer-copy a {
        color: inherit;
        text-decoration: none;
    }
    .footer-copy a:hover {
        color: rgba(255, 255, 255, 0.7);
        text-decoration: underline;
    }
    code {
        font-family:
            Menlo,
            Monaco,
            Lucida Console,
            Liberation Mono,
            DejaVu Sans Mono,
            Bitstream Vera Sans Mono,
            Courier New,
            monospace;
    }
</style>
